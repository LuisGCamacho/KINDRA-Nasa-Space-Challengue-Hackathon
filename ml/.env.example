# Plantilla de ml/.env. Copiar a ml/.env y completar. ml/.env NUNCA se sube a Git.

# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (gratis, llega por correo).
FIRMS_MAP_KEY=

# Agente: Gemini Flash por la API compatible con OpenAI (clave de https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Base de datos (opcional): sin ella la app usa los JSON de web/data/.
DATABASE_URL=
