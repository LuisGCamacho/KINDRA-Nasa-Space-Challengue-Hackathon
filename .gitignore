/ml/models/
/ml/data/false_positives/
/web/data/live/
/web/public/live/
/web/public/cesium/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

